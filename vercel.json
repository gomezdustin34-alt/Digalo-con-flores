{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "45mb" }
    },
    {
      "src": "app/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/dist/(.*)",
      "dest": "/app/static/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/static/img/(.*)",
      "dest": "/app/static/img/$1",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/app/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
