# === Aplicación ===
FLASK_APP=wsgi.py
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# === Base de datos ===
# SQLite por defecto (desarrollo). Para producción, apuntar a MySQL, ej:
# DATABASE_URL=mysql+pymysql://usuario:password@host:3306/digaloconflores
DATABASE_URL=sqlite:///digaloconflores.db

# === Email (SMTP genérico — Gmail, Zoho, hosting propio, etc.) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="Dígalo con Flores <no-reply@digaloconflores.com>"

# === Sitio ===
SITE_URL=http://127.0.0.1:5000
CURRENCY=COP

# === Rate limiting ===
RATELIMIT_STORAGE_URI=memory://
