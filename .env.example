# === Aplicación ===
FLASK_APP=wsgi.py
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# === Base de datos ===
# SQLite por defecto (desarrollo). En producción, PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require
DATABASE_URL=sqlite:///digaloconflores.db

# === Email (SMTP genérico — Gmail, Zoho, hosting propio, etc.) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="Dígalo con Flores <no-reply@digaloconflores.com>"

# === Sitio ===
SITE_URL=http://127.0.0.1:5000
CURRENCY=COP

# === Rate limiting ===
RATELIMIT_STORAGE_URI=memory://

# === Zona horaria (cortes de día del panel y del calendario) ===
TIMEZONE=America/Bogota

# === Sesiones ===
# Días que dura una sesión iniciada antes de caducar sola.
SESSION_DAYS=7
# Poner a 1 si el sitio corre tras HTTPS fuera de un entorno serverless.
FORCE_HTTPS=0

# === Aviso de pedidos por WhatsApp (API oficial de Meta) ===
# Sin estas variables simplemente no se envía el aviso; nada más deja de funcionar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
# Fuera de la ventana de 24 h, Meta exige una plantilla aprobada:
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=es

# NUNCA pongas valores reales en este archivo: es el que se versiona.
# Los valores de verdad van en .env (ignorado por git) o en las variables de
# entorno del hosting.
